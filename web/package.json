{
  "name": "@visarium/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --ignore-snapshots e2e/auth.spec.ts e2e/shell.spec.ts e2e/canvas.spec.ts e2e/canvas.capture.spec.ts e2e/canvas.persistence.spec.ts e2e/library.spec.ts e2e/interchange.spec.ts",
    "bench": "playwright test canvas.bench --workers=1",
    "measure": "playwright test canvas.memory --workers=1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.29",
    "@visarium/api-client": "workspace:*",
    "@visarium/canvas-core": "workspace:*",
    "@visarium/canvas-renderer-konva": "workspace:*",
    "konva": "10.3.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.32",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "happy-dom": "20.11.2",
    "tailwindcss": "4.3.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
