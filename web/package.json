{
  "name": "@visarium/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode devtools",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --ignore-snapshots e2e/auth.spec.ts e2e/shell.spec.ts e2e/canvas.spec.ts e2e/canvas.capture.spec.ts e2e/canvas.persistence.spec.ts e2e/library.spec.ts e2e/interchange.spec.ts e2e/canvas.crop.spec.ts e2e/canvas.objects.spec.ts e2e/canvas.objects.edit.spec.ts e2e/canvas.links.spec.ts e2e/canvas.inspector.spec.ts e2e/canvas.scenario.spec.ts",
    "bench": "playwright test canvas.bench --workers=1",
    "measure": "playwright test canvas.memory --workers=1"
  },
  "dependencies": {
    "@plantuml/core": "1.2026.9",
    "@tanstack/react-query": "5.107.2",
    "@tanstack/react-router": "1.170.46",
    "@visarium/api-client": "workspace:*",
    "@visarium/canvas-core": "workspace:*",
    "@visarium/canvas-renderer-konva": "workspace:*",
    "dompurify": "3.4.17",
    "konva": "10.9.1",
    "marked": "18.1.3",
    "mermaid": "12.3.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
