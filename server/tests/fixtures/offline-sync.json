    "height": 90,
    "rotation": 0
   },
   "z": 7,
   "content": {
    "kind": "note",
    "source": "Retry with exponential backoff, capped at 30 s. Reset after a successful commit."
   },
   "groupId": "00000000-0000-4000-8000-000000000102"
  },
  {
   "type": "item.create",
   "itemId": "00000000-0000-4000-8000-000000000008",
   "transform": {
