{
  "name": "visarium",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.13",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @visarium/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @visarium/web test:e2e",
    "verify": "pnpm typecheck && pnpm check && pnpm test && pnpm build",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tauri-apps/cli": "2.12.5",
    "typescript": "7.0.2"
  }
}
