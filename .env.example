# Copy to .env for local Docker Compose runs. Never commit .env.

# --- Application ---
# Host port the application is published on.
APP_PORT=8080
# UID:GID the app runs as. Must be able to write all three paths below.
APP_UID=1000
APP_GID=1000

# --- Database ---
# The SQLite database. Canonical data: back it up. Keep it on a LOCAL disk —
# not an NFS/SMB mount (DEPLOYMENT.md says why).
DATABASE_HOST_PATH=./data/db

# --- Asset storage ---
# Host path holding ORIGINAL asset files. Canonical data: back it up.
# A local disk, a ZFS dataset, or an NFS/SMB mount of your NAS.
ASSETS_HOST_PATH=./data/assets

# --- Derivatives ---
# Regenerable cache. Losing this costs CPU, not data.
DERIVATIVES_HOST_PATH=./data/derivatives

# --- Sign-in (DEPLOYMENT.md, "Who can see what") ---
# The address people use. Required for sign-in providers and share links.
# VISARIUM_PUBLIC_URL=https://visarium.example.net
# Any OpenID Connect provider; the id (here STUDIO) names its callback:
#   {VISARIUM_PUBLIC_URL}/auth/oidc/studio/callback
# VISARIUM_OIDC_STUDIO_ISSUER=https://id.example.net/application/o/visarium/
# VISARIUM_OIDC_STUDIO_CLIENT_ID=
# VISARIUM_OIDC_STUDIO_CLIENT_SECRET=
# VISARIUM_OIDC_STUDIO_NAME=Studio SSO
# VISARIUM_AUTH_PASSWORD=off   # SSO only
# VISARIUM_SHARING=off
